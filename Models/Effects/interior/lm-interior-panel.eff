<?xml version="1.0" encoding="utf-8"?>

<PropertyList>
    <name>lm-interior-panel</name>
    <inherits-from>Effects/model-pbr</inherits-from>
    <parameters>
        <texture n="3">
            <type>2d</type>
            <image>Effects/interior/lm_panel-post.png</image>
            <filter>linear-mipmap-linear</filter>
            <mag-filter>linear</mag-filter>
            <wrap-s>clamp-to-edge</wrap-s>
            <wrap-t>clamp-to-edge</wrap-t>
        </texture>
        <emissive-factor type="vec3d">0.0010 0.00095 0.00085</emissive-factor>
    </parameters>
</PropertyList>


