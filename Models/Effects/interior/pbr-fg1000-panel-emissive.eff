<?xml version="1.0" encoding="utf-8"?>

<PropertyList>
  <name>pbr-fg1000-panel-emissive</name>
  <inherits-from>Effects/model-pbr</inherits-from>

  <parameters>
    <!-- Base color -->
    <texture n="0">
      <type>image</type>
      <image>Aircraft/c172p/Models/Interior/Panel/c172sp-panel/panel-fg1000.png</image>
    </texture>

    <!-- Normal -->
    <texture n="1">
      <type>image</type>
      <image>Aircraft/c172p/Models/Interior/Panel/c172sp-panel/panel-fg1000.png</image>
    </texture>

    <!-- ORM -->
    <texture n="2">
      <type>image</type>
      <image>Aircraft/c172p/Models/Interior/Panel/c172sp-panel/panel-fg1000.png</image>
    </texture>

    <!-- Emissive uses the SAME texture as basecolor -->
    <texture n="3">
      <type>image</type>
      <image>Aircraft/c172p/Models/Interior/Panel/c172sp-panel/panel-fg1000.png</image>
    </texture>

    <!-- EXACT ALS emit color × intensity -->
    <emissive-factor type="vec3d">
      <value>
        0.75 * <use>/controls/lighting/swcb</use>
        0.60 * <use>/controls/lighting/swcb</use>
        0.50 * <use>/controls/lighting/swcb</use>
      </value>
    </emissive-factor>

    <alpha-cutoff type="float">0.0</alpha-cutoff>
  </parameters>
</PropertyList>

