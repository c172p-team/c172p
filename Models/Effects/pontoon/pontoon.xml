                    </sum>
                    <value>15</value>
                </product>
                <product>
                    <table>
                        <property alias="/params/gear-amphibious/rear-left-position-norm"/>
                        <entry>
                            <ind>1</ind>
                            <dep>0</dep>
                        </entry>
                        <entry>
                            <ind>0</ind>
                            <dep>10</dep>
                        </entry>
                    </table>
                </product>
            </sum>
        </expression>
        <center>
            <x-m>-0.6019</x-m>
            <y-m>-1.1513</y-m>
            <z-m>-1.8621</z-m>
        </center>
        <axis>
            <x>0</x>
