<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- Adapted from the Diamond-da40 -->

<PropertyList>

    <path>elt-fg1000.gltf</path>
	
	    <animation>
        <type>pick</type>
        <object-name>ELTSwitch</object-name>
        <visible>true</visible>
        <action>
            <button>0</button>
            <repeatable>false</repeatable>
            <binding>
                <command>property-toggle</command>
                <property>controls/switches/eltswitch</property>
            </binding>
            <binding>
                <command>nasal</command>
                <script>c172p.click("avionics")</script>
            </binding>
        </action>
        <hovered>
            <binding>
                <command>set-tooltip</command>
                <tooltip-id>ELT-switch</tooltip-id>
                <label>ELT: %s</label>
                <mapping>on-off</mapping>
                <property>controls/switches/eltswitch</property>
            </binding>
        </hovered>
    </animation>
    <animation>
        <type>rotate</type>
        <object-name>ELTSwitch</object-name>
        <property>controls/switches/eltswitch</property>
        <factor>-20</factor>
        <axis>
            <x>0.0</x>
            <y>1.0</y>
            <z>0.0</z>
        </axis>
    </animation>

    <animation>
        <type>pbr</type>
        <object-name>eltlamp</object-name>
        <emissive-factor>
            <r>
                <property>controls/switches/eltswitch</property>
                <scale>100</scale>
            </r>
            <g>
                <property>controls/switches/eltswitch</property>
                <scale>0</scale>
            </g>
            <b>
                <property>controls/switches/eltswitch</property>
                <scale>0</scale>
            </b>
        </emissive-factor>
        <emissive-texture>../../../Effects/interior/panel-parts.png</emissive-texture>
    </animation>
    <light>
        <name>ELTLed</name>
        <type>spot</type>

        <position>
            <x-m>-0.363</x-m>
            <y-m> 0.308</y-m>
            <z-m> 0.136</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-1</z>
        </direction>

        <color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
        </color>

        <intensity>1.0</intensity>

        <spot-exponent>12</spot-exponent>
        <spot-cutoff>6</spot-cutoff>
        <range-m>0.009</range-m>
    </light>
    <animation>
        <type>select</type>
        <object-name>ELTLed</object-name>
        <condition>
            <greater-than>
                <property>controls/switches/eltswitch</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
