    <light>
        <name>Ai-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.221703</y-m>
            <z-m> 0.148</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.85</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.1</factor>
        </intensity>

        <spot-exponent>16.0</spot-exponent>
        <spot-cutoff>50</spot-cutoff>
        <range-m>.09</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>Ai-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

