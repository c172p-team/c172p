<?xml version="1.0"?>

<PropertyList>

    <path>fuel.gltf</path>

    <animation>
        <type>rotate</type>
        <object-name>LeftFuelNeedle</object-name>
        <property>consumables/fuel/tank[0]/indicated-level-gal_us</property>
        <interpolation>
            <entry>
                <ind>0</ind>
                <dep>-29</dep>
            </entry>
            <entry>
                <ind>5</ind>
                <dep>-18</dep>
            </entry>
            <entry>
                <ind>10</ind>
                <dep>-7</dep>
            </entry>
            <entry>
                <ind>16</ind>
                <dep>3</dep>
            </entry>
			<entry>
                <ind>21</ind>
                <dep>6</dep>
            </entry>
            <entry>
                <ind>26</ind>
                <dep>19</dep>
            </entry>
            <entry>
                <ind>34</ind>
                <dep>34</dep>
            </entry>
        </interpolation>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
    </animation>


    <animation>
        <type>rotate</type>
        <object-name>RightFuelNeedle</object-name>
        <property>consumables/fuel/tank[1]/indicated-level-gal_us</property>
        <interpolation>
            <entry>
                <ind>0</ind>
                <dep>-29</dep>
            </entry>
            <entry>
                <ind>5</ind>
                <dep>-18</dep>
            </entry>
            <entry>
                <ind>10</ind>
                <dep>-7</dep>
            </entry>
            <entry>
                <ind>16</ind>
                <dep>3</dep>
            </entry>
			<entry>
                <ind>21</ind>
                <dep>6</dep>
            </entry>
            <entry>
                <ind>26</ind>
                <dep>19</dep>
            </entry>
            <entry>
                <ind>34</ind>
                <dep>34</dep>
            </entry>
        </interpolation>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
    </animation>

    <light>
        <name>FuelL-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.419685</y-m>
            <z-m> 0.041</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.001</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.0001</factor>
        </intensity>

        <spot-exponent>64.0</spot-exponent>
        <spot-cutoff>80</spot-cutoff>
        <range-m>0.041</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>FuelL-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

    <light>
        <name>FuelR-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.38956</y-m>
            <z-m> 0.041</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.001</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.0001</factor>
        </intensity>

        <spot-exponent>64.0</spot-exponent>
        <spot-cutoff>80</spot-cutoff>
        <range-m>0.041</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>FuelR-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
