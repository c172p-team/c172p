<?xml version="1.0"?>

<PropertyList>

    <path>oil.gltf</path>

    <animation>
        <type>rotate</type>
        <object-name>OilTempNeedle</object-name>
        <property>engines/active-engine/indicated-oil-final-temperature-degf</property>
        <interpolation>
            <entry>
                <ind>0</ind>
                <dep>-29</dep>
            </entry>
            <entry>
                <ind>100</ind>
                <dep>-22</dep>
            </entry>
            <entry>
                <ind>245</ind>
                <dep>29</dep>
            </entry>
        </interpolation>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
    </animation>

    <animation>
        <type>rotate</type>
        <object-name>OilPressNeedle</object-name>
        <property>engines/active-engine/indicated-oil-pressure-psi</property>
        <interpolation>
            <entry>
                <ind>0</ind>
                <dep>-27</dep>
            </entry>
            <entry>
                <ind>50</ind>
                <dep>2</dep>
            </entry>
            <entry>
                <ind>90</ind>
                <dep>16</dep>
            </entry>
            <entry>
                <ind>115</ind>
                <dep>26</dep>
            </entry>
        </interpolation>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
    </animation>

    <light>
        <name>OilL-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.418924</y-m>
            <z-m> 0.000</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.001</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.0001</factor>
        </intensity>

        <spot-exponent>64.0</spot-exponent>
        <spot-cutoff>80</spot-cutoff>
        <range-m>0.041</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>OilL-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

    <light>
        <name>OilR-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.386855</y-m>
            <z-m>0.000</z-m>
        </position>

        <direction>
            <x> 0    </x>
            <y> 0    </y>
            <z>-0.001</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.0001</factor>
        </intensity>

        <spot-exponent>64.0</spot-exponent>
        <spot-cutoff>80</spot-cutoff>
        <range-m>0.042</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>OilR-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
