<?xml version="1.0"?>

<PropertyList>

    <path>rpm.gltf</path>
    <!--path>RPM.ac</path-->

    <params>
        <engine>
            <rpm>engines/engine[2]/rpm</rpm>
        </engine>
    </params>

    <animation>
        <type>rotate</type>
        <object-name>PointerCentre</object-name>
        <object-name>PointerTip</object-name>
        <property alias="/params/engine/rpm"/>
        <interpolation>
            <entry>
                <ind>0</ind>
                <dep>16</dep>
            </entry>
            <entry>
                <ind>300</ind>
                <dep>18</dep>
            </entry>
            <entry>
                <ind>500</ind>
                <dep>30</dep>
            </entry>
            <entry>
                <ind>1000</ind>
                <dep>68</dep>
            </entry>
            <entry>
                <ind>1500</ind>
                <dep>106</dep>
            </entry>
            <entry>
                <ind>2000</ind>
                <dep>144</dep>
            </entry>
            <entry>
                <ind>2500</ind>
                <dep>182</dep>
            </entry>
            <entry>
                <ind>3000</ind>
                <dep>220</dep>
            </entry>
            <entry>
                <ind>3500</ind>
                <dep>258</dep>
            </entry>
        </interpolation>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
    </animation>

    <!--animation>
        <type>pbr</type>
        <object-name>Face</object-name>
        <object-name>PointerCentre</object-name>
        <object-name>PointerTip</object-name>
        <object-name>Case</object-name>
        <emissive-factor>
            <r>
                <property>/sim/model/lightmap/instruments/factor</property>
                <scale>1.0</scale>
            </r>
            <g>
                <property>/sim/model/lightmap/instruments/factor</property>
                <scale>0.8</scale>
            </g>
            <b>
                <property>/sim/model/lightmap/instruments/factor</property>
                <scale>0.5</scale>
            </b>
        </emissive-factor>
        <emissive-texture>../../../Effects/interior/lm_rpm-post.png</emissive-texture>
    </animation-->

    <light>
        <name>Rpm-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.312294</y-m>
            <z-m>-0.060</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.85</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.1</factor>
        </intensity>

        <spot-exponent>16.0</spot-exponent>
        <spot-cutoff>50</spot-cutoff>
        <range-m>0.09</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>Rpm-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
