<?xml version="1.0"?>

<PropertyList>

    <path>vsi.gltf</path>

    <animation>
        <type>rotate</type>
        <object-name>PointerCentre</object-name>
        <object-name>PointerTip</object-name>
        <property>instrumentation/vertical-speed-indicator/indicated-speed-fpm-final</property>
        <interpolation>
            <entry>
                <ind>-2000</ind>
                <dep>-176</dep>
            </entry>
            <entry>
                <ind>-1500</ind>
                <dep>-133</dep>
            </entry>
            <entry>
                <ind>-1000</ind>
                <dep>-88</dep>
            </entry>
            <entry>
                <ind>-500</ind>
                <dep>-44</dep>
            </entry>
            <entry>
                <ind>0</ind>
                <dep>0</dep>
            </entry>
            <entry>
                <ind>500</ind>
                <dep>44</dep>
            </entry>
            <entry>
                <ind>1000</ind>
                <dep>88</dep>
            </entry>
            <entry>
                <ind>1500</ind>
                <dep>133</dep>
            </entry>
            <entry>
                <ind>2000</ind>
                <dep>176</dep>
            </entry>
        </interpolation>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
    </animation>

    <light>
        <name>Vsi-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.132126</y-m>
            <z-m> 0.043</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.85</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.1</factor>
        </intensity>

        <spot-exponent>16.0</spot-exponent>
        <spot-cutoff>50</spot-cutoff>
        <range-m>0.09</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>Vsi-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
