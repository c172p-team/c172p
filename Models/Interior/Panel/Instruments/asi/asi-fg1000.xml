    <animation>
        <type>rotate</type>
        <object-name>Needle</object-name>
        <property>fdm/jsbsim/velocities/vias-kts</property>
        <interpolation>
            <entry>
                <ind>   0</ind>
                <dep>    0</dep>
            </entry>
            <entry>
                <ind>  35</ind>
                <dep>   27</dep>
            </entry>
            <entry>
                <ind>  40</ind>
                <dep>   41</dep>
            </entry>
            <entry>
                <ind>  60</ind>
                <dep>   91</dep>
            </entry>
            <entry>
                <ind>  80</ind>
                <dep>  143</dep>
            </entry>
            <entry>
                <ind> 100</ind>
                <dep>  197</dep>
            </entry>
            <entry>
                <ind> 120</ind>
                <dep>  240</dep>
            </entry>
            <entry>
                <ind> 140</ind>
                <dep>  282</dep>
            </entry>
            <entry>
                <ind> 160</ind>
                <dep>  324</dep>
            </entry>
            <entry>
                <ind> 190</ind>
                <dep>  331</dep>
            </entry>
        </interpolation>
        <axis>
            <x>-1</x>
            <y> 0</y>
            <z> 0</z>
        </axis>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
    </animation>

    <light>
        <name>Asi-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.347591</x-m>
            <y-m>-0.03229 </y-m>
            <z-m>-0.079636</z-m>
        </position>

        <direction>
            <x>-0.4</x>
            <y>0</y>
            <z>-0.627</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/controls/lighting/stby</property>
            <factor>.00001</factor>
        </intensity>

        <spot-exponent>4.0</spot-exponent>
        <spot-cutoff>80</spot-cutoff>
        <range-m>.25</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>Asi-Post</object-name>
        <condition>
            <greater-than>
                <property>/controls/lighting/stby</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
