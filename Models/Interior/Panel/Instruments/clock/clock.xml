<?xml version="1.0"?>

<PropertyList>

    <path>clock.gltf</path>

    <animation>
        <type>rotate</type>
        <object-name>SecondHand</object-name>
        <property>sim/model/c172p/local-time-seconds</property>
        <factor>6</factor>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
    </animation>

    <animation>
        <type>rotate</type>
        <object-name>MinuteHand</object-name>
        <property>sim/model/c172p/local-time-seconds</property>
        <factor>0.1</factor>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
    </animation>

    <animation>
        <type>rotate</type>
        <object-name>HourHand</object-name>
        <property>sim/model/c172p/local-time-seconds</property>
        <factor>0.008333</factor>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
    </animation>

    <light>
        <name>ClockPost</name>
        <type>spot</type>
        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.388189</y-m>
            <z-m> 0.11</z-m>
        </position>
        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.85</z>
        </direction>
        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>
        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.0001</factor>
        </intensity>
        <spot-exponent>32.0</spot-exponent>
        <spot-cutoff>50</spot-cutoff>
        <range-m>0.05</range-m>
        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>ClockPost</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
