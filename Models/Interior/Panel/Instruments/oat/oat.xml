<?xml version="1.0"?>

<PropertyList>

    <path>oat.gltf</path>

    <animation>
        <type>rotate</type>
        <object-name>OAT.needle</object-name>
        <property>environment/temperature-degc</property>
        <offset-deg>130</offset-deg>
        <factor>2.166</factor>
        <!-- notice: 0 = -60 * 2.17 + 130, 260 = 60 * 2.17 + 130 -->
        <axis>
            <x>0</x>
            <y>1</y>
            <z>0</z>
        </axis>
    </animation>
</PropertyList>
