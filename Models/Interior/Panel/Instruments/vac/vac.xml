<?xml version="1.0"?>

<PropertyList>

    <path>vac.gltf</path>

    <animation>
        <type>rotate</type>
        <object-name>VacNeedle</object-name>
        <property>systems/vacuum/suction-inhg</property>
        <interpolation>
            <entry>
                <ind>  0.0</ind>
                <dep>-165 </dep>
            </entry>
            <entry>
                <ind>  1.0</ind>
                <dep>-132</dep>
            </entry>
            <entry>
                <ind>  2.0</ind>
                <dep>-99</dep>
            </entry>
            <entry>
                <ind> 3.0</ind>
                <dep> -66 </dep>
            </entry>
            <entry>
                <ind> 4.0</ind>
                <dep> -33 </dep>
            </entry>
            <entry>
                <ind> 5.0</ind>
                <dep>  0 </dep>
            </entry>
            <entry>
                <ind> 6.0</ind>
                <dep>  33 </dep>
            </entry>
            <entry>
                <ind> 7.00</ind>
                <dep> 66 </dep>
            </entry>
            <entry>
                <ind> 8.0</ind>
                <dep>  99 </dep>
            </entry>
            <entry>
                <ind> 9.0</ind>
                <dep> 132 </dep>
            </entry>
            <entry>
                <ind> 8.0</ind>
                <dep> 165 </dep>
            </entry>
        </interpolation>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0</z-m>
        </center>
    </animation>

    <light>
        <name>Vac-Post</name>
        <type>spot</type>

        <position>
            <x-m>-0.36</x-m>
            <y-m>-0.431458</y-m>
            <z-m> 0.075</z-m>
        </position>

        <direction>
            <x>0</x>
            <y>0</y>
            <z>-0.85</z>
        </direction>

        <color>
            <r>1.0</r>
            <g>1.0</g>
            <b>1.0</b>
        </color>

        <intensity>
            <property>/sim/model/lightmap/instruments/factor</property>
            <factor>.0001</factor>
        </intensity>

        <spot-exponent>64.0</spot-exponent>
        <spot-cutoff>40</spot-cutoff>
        <range-m>0.03</range-m>

        <debug-color>
            <r>1</r>
            <g>0</g>
            <b>0</b>
            <a>1</a>
        </debug-color>
    </light>
    <animation>
        <type>select</type>
        <object-name>Vac-Post</object-name>
        <condition>
            <greater-than>
                <property>/sim/model/lightmap/instruments/factor</property>
                <value>0</value>
            </greater-than>
        </condition>
    </animation>

</PropertyList>
